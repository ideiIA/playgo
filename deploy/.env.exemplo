# PlayGo — configuração de produção própria (modelo). NÃO commite o arquivo gerado (.env).
# Gere o .env com:  python deploy/gerar_credenciais.py --dominio playgo.seudominio.com.br --email voce@seudominio.com.br

# --- Publicação ---
DOMINIO=__DOMINIO__
EMAIL_ACME=__EMAIL_ACME__

# --- Banco (Postgres do próprio compose; a URL é montada pelo docker-compose.yml) ---
POSTGRES_PASSWORD=__SENHA_BANCO__

# --- Segurança ---
PLAYGO_CHAVE_SESSAO=__CHAVE_SESSAO__
PLAYGO_CRON_SECRET=__CRON_SECRET__

# --- Fuso ---
PLAYGO_FUSO=America/Campo_Grande

# --- LGPD (preencher antes de abrir ao público; ver docs/lgpd.md) ---
PLAYGO_CONTROLADOR_NOME=Razão social da empresa
PLAYGO_CONTATO_PRIVACIDADE=privacidade@seudominio.com.br
PLAYGO_RETENCAO_REGISTROS_DIAS=365

# --- Login com Google (opcional). Redirect autorizado: https://<DOMINIO>/auth/google/retorno ---
PLAYGO_GOOGLE_CLIENT_ID=
PLAYGO_GOOGLE_CLIENT_SECRET=

# --- Instagram do PlayGo (opcional). Retorno OAuth no app da Meta: https://<DOMINIO>/instagram/retorno ---
# ID e chave do app em developers.facebook.com. A conta se conecta por botão em Administração → Instagram (docs/instagram.md).
PLAYGO_INSTAGRAM_APP_ID=
PLAYGO_INSTAGRAM_APP_SECRET=

# --- YouTube do PlayGo: transmissão ao vivo dos jogos (opcional; docs/youtube.md). Redirect OAuth: https://<DOMINIO>/youtube/retorno ---
PLAYGO_YOUTUBE_CLIENT_ID=
PLAYGO_YOUTUBE_CLIENT_SECRET=
PLAYGO_YOUTUBE_MAX_SIMULTANEAS=4
# Câmera pelo navegador (LiveKit Cloud, opcional): projeto em cloud.livekit.io > Settings > Keys
PLAYGO_LIVEKIT_URL=
PLAYGO_LIVEKIT_API_KEY=
PLAYGO_LIVEKIT_API_SECRET=

# --- Cobrança Asaas (opcional). Webhook: https://<DOMINIO>/api/v1/cobranca/asaas com o token abaixo ---
PLAYGO_ASAAS_API_KEY=
PLAYGO_ASAAS_AMBIENTE=sandbox
PLAYGO_ASAAS_WEBHOOK_TOKEN=__TOKEN_ASAAS__
# Recebimentos de parceiros (Arena recebe pelo app; subconta Asaas BaaS). Mantenha "desligado" até concluir o processo com o Asaas (docs/deploy.md).
PLAYGO_RECEBIMENTOS_FASE=desligado
PLAYGO_ASAAS_WEBHOOK_TOKEN_PARCEIROS=
PLAYGO_ASAAS_WALLET_ID=
PLAYGO_RECEBIMENTOS_CHAVE=
PLAYGO_RECEBIMENTOS_COMISSAO_PERCENTUAL=0
PLAYGO_RECEBIMENTOS_COMISSAO_FIXA=0
PLAYGO_RECEBIMENTOS_TAXA_POR=arena
PLAYGO_RECEBIMENTOS_SAQUE_MINIMO=10
PLAYGO_TESTE_DIAS=30
PLAYGO_TOLERANCIA_DIAS=7

# --- Moderação por IA (opcional; sem chave, fotos/vídeos vão para a análise da equipe) ---
PLAYGO_ANTHROPIC_API_KEY=
PLAYGO_GEMINI_API_KEY=
PLAYGO_MODERACAO_MIDIA_SEM_IA=revisar

# --- Arquivos enviados ---
PLAYGO_MAX_FOTO_MB=10
PLAYGO_MAX_VIDEO_MB=50
PLAYGO_MAX_PDF_MB=15
