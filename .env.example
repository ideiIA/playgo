# Copie para .env e ajuste. Sem .env, vale o banco de desenvolvimento (scripts\dev_db.ps1).
PLAYGO_DATABASE_URL=postgresql+psycopg://playgo@localhost:5434/playgo

# Chave que assina o cookie de sessão e os tokens do app. Em branco = gerada em .chave_sessao.
PLAYGO_CHAVE_SESSAO=

# Fuso do servidor: define o "hoje" e o "começa em X min".
PLAYGO_FUSO=America/Campo_Grande

# Onde o mapa abre para quem ainda não informou a localização (padrão: Campo Grande, MS).
PLAYGO_LATITUDE_PADRAO=-20.4697
PLAYGO_LONGITUDE_PADRAO=-54.6201

# Lembretes ("seu jogo começa em 2 horas") e reposição pela lista de espera.
# A interface dispara o agendador; em produção também dá para rodar `python -m playgo agendador`.
PLAYGO_AGENDADOR_NA_WEB=true
PLAYGO_INTERVALO_AGENDADOR_S=60

# --- Moderação por IA das publicações (opcional) ---
# Escolha o provedor e preencha a chave dele. Sem chave: só valem as regras locais, e foto/vídeo vão para a fila do admin.
#   claude: chave em https://console.anthropic.com/  (modelo padrão: claude-haiku-4-5-20251001; só analisa imagens)
#   gemini: chave em https://aistudio.google.com/apikey  (modelo padrão: gemini-flash-latest; analisa imagens e vídeos até ~18 MB)
PLAYGO_IA_PROVEDOR=
PLAYGO_ANTHROPIC_API_KEY=
PLAYGO_GEMINI_API_KEY=
# PLAYGO_MODELO_MODERACAO=
# O que fazer com foto/vídeo quando nenhuma IA consegue analisar: revisar (admin avalia) | liberar
PLAYGO_MODERACAO_MIDIA_SEM_IA=revisar

# --- Publicações e mídia ---
PLAYGO_MAX_FOTO_MB=10
PLAYGO_MAX_VIDEO_MB=50
PLAYGO_MAX_PDF_MB=15          # regulamento em PDF (no Vercel o teto efetivo é 4 MB)
PLAYGO_JANELA_EXCLUSAO_MIN=60

# --- LGPD / Marco Civil (preencher antes de produção; ver docs/lgpd.md) ---
# PLAYGO_CONTROLADOR_NOME=Razão social da empresa
# PLAYGO_CONTATO_PRIVACIDADE=privacidade@suaempresa.com.br
PLAYGO_RETENCAO_REGISTROS_DIAS=365
# Só atrás de proxy de confiança: lê o IP real de X-Forwarded-For
PLAYGO_CONFIAR_PROXY=false

# --- Produção (Supabase + Vercel; ver docs/deploy.md) ---
# Pooler do Supabase (porta 6543) no Vercel; em dev use o Postgres local.
# PLAYGO_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# PLAYGO_SUPABASE_URL=https://<ref>.supabase.co
# PLAYGO_SUPABASE_SERVICE_KEY=   # service_role: secreta, só no servidor
# PLAYGO_SUPABASE_BUCKET=playgo-midia
# PLAYGO_SERVERLESS=true         # o Vercel já define VERCEL; isto força o modo
# CRON_SECRET=                   # protege /api/v1/cron/ciclo

# --- Planos e cobrança (Asaas) ---
# Comece pelo SANDBOX (https://sandbox.asaas.com): chave $aact_hmlg_... Depois troque para produção.
# PLAYGO_ASAAS_API_KEY=
# PLAYGO_ASAAS_AMBIENTE=sandbox        # sandbox | producao
# PLAYGO_ASAAS_WEBHOOK_TOKEN=          # invente um token e cadastre o mesmo no webhook do Asaas

# Login com Google (Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth, tipo "Aplicativo da Web").
# URI de redirecionamento autorizado: https://SEU-APP.vercel.app/auth/google/retorno (e http://localhost:8010/auth/google/retorno para testar)
# PLAYGO_GOOGLE_CLIENT_ID=
# PLAYGO_GOOGLE_CLIENT_SECRET=
# PLAYGO_URL_PUBLICA=https://SEU-APP.vercel.app   # só se o endereço detectado sair errado
# PLAYGO_TESTE_DIAS=30
# PLAYGO_TOLERANCIA_DIAS=7

# --- Instagram do PlayGo (app da Meta; ver docs/instagram.md) ---
# PLAYGO_INSTAGRAM_APP_ID=
# PLAYGO_INSTAGRAM_APP_SECRET=
# PLAYGO_INSTAGRAM_VERSAO=v21.0

# --- YouTube do PlayGo (transmissão ao vivo dos jogos; docs/youtube.md) ---
# PLAYGO_YOUTUBE_CLIENT_ID=
# PLAYGO_YOUTUBE_CLIENT_SECRET=
# PLAYGO_YOUTUBE_MAX_SIMULTANEAS=4
# PLAYGO_LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# PLAYGO_LIVEKIT_API_KEY=
# PLAYGO_LIVEKIT_API_SECRET=

# --- Servidor próprio atrás do Caddy (o deploy/docker-compose.yml já define) ---
# PLAYGO_COOKIE_SEGURO=true
# PLAYGO_ARMAZENAMENTO=local
